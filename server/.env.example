# OpenRouter API Configuration for Chat System
# Copy this file to .env and add your actual API key
# Get your API key from: https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model selection (OpenRouter format: provider/model-name)
# Recommended: GPT-4o-mini (excellent quality, low cost, ~$0.0002/query)
# Other options:
#   - deepseek/deepseek-chat (~$0.0004/query - 90% of GPT-5 quality, great value)
#   - openai/gpt-4o (~$0.003/query - best quality, top-tier instruction following)
#   - anthropic/claude-sonnet-4 (~$0.004/query - best for nuanced scientific text)
#   - meta-llama/llama-3-70b-instruct (~$0.0008/query - cheapest option)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: CORS origins for production (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://anotherdomain.com
